# 個人用の値は .env.local にだけ記入し、コミットしないでください。
DATABASE_URL=sqlite:///data/app.db
DATA_DIR=data
TIMEZONE=Asia/Tokyo
WEB_HOST=127.0.0.1
WEB_PORT=8765
# 初期状態は外部連携・定期投稿を無効化
OPENAI_INBOX_CLASSIFIER_ENABLED=false
NOTION_SYNC_ENABLED=false
RHYTHM_ENABLED=false
RHYTHM_SCHEDULER_ENABLED=false
DEVICE_SYNC_ENABLED=false
HEALTH_ENABLED=false
REMINDER_SCHEDULER_ENABLED=false
FINANCE_DIGEST_ENABLED=false
# Botを使う場合のみ、以下を .env.local に追加
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# ALLOWED_USER_ID=
# GENERAL_INBOX_CHANNEL_ID=
# GENERAL_ARCHIVE_CHANNEL_ID=
# OpenAI / Notion は任意。デモの実行には不要です。
# OPENAI_API_KEY=
# NOTION_API_TOKEN=
# NOTION_PARENT_ID=
