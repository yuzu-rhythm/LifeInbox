FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# This image contains the same package as the Bot so it can share the
# SQLAlchemy event schema, but its command starts only the narrow device-sync
# ASGI application. It never receives Discord credentials from the image.
COPY pyproject.toml README.md ./
COPY src/life_inbox ./src/life_inbox

RUN pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

CMD ["python", "-m", "life_inbox.device_sync_cloud"]
